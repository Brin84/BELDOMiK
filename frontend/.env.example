# Frontend Environment Variables
# Copy this file to .env and fill in your values

# API Base URL (relative or absolute)
# In development, can be empty to use Vite proxy
# In production, should be the full API URL
VITE_API_URL=

# Telegram Bot username (for deep links)
VITE_TG_BOT_USERNAME=

# Analytics (optional)
VITE_YANDEX_METRIKA_ID=
VITE_GA_MEASUREMENT_ID=

# Sentry (optional)
VITE_SENTRY_DSN=
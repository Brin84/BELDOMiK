# ── Core ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/beldomik
SECRET_KEY=change-me-in-production

# ── Public URLs ─────────────────────────────────────────────────────────
BACKEND_PUBLIC_URL=https://your-backend.example
FRONTEND_URL=https://your-frontend.example
TELEGRAM_WEBAPP_URL=https://your-mini-app.example

# ── Telegram ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=beldomik_bot
TELEGRAM_WEBHOOK_SECRET=

# ── Object storage — Google Cloud Storage (production on Cloud Run) ─────
# Used via runtime service account (ADC); bucket has uniform access +
# public objectViewer, so keys are readable at:
#   https://storage.googleapis.com/{GCS_BUCKET_NAME}/{object_key}
GCS_BUCKET_NAME=beldomik-photos
GCS_PUBLIC_URL=https://storage.googleapis.com

# ── Object storage — S3-compatible fallback (Cloudflare R2 / AWS S3) ────
# S3 is used when GCS credentials are unavailable.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=beldomik
S3_REGION=auto
S3_PUBLIC_URL=

# ── File upload ─────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=["image/jpeg", "image/png", "image/webp", "image/avif"]
MAX_IMAGES_PER_PROPERTY=20
PHOTO_MAX_DIMENSION=1600
PHOTO_QUALITY=80

# ── Scheduler keep-alive ────────────────────────────────────────────────
SCHEDULER_SECRET=

# ── Currency ────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=BYN
SUPPORTED_CURRENCIES=["BYN", "USD"]